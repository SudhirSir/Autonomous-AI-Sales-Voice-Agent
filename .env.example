# Optional LLM & Embedding Provider (works locally out-of-the-box without keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Pluggable Voice Providers (auto | gemini | deepgram | whisper | faster-whisper | elevenlabs | google | piper | windows-sapi | browser)
STT_PROVIDER=auto
TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GOOGLE_TTS_API_KEY=
WHISPER_MODEL_SIZE=tiny
PIPER_MODEL_EN=
PIPER_MODEL_HI=

# Storage, PostgreSQL (optional) & Knowledge Base
FORTIVEX_DB_PATH=data/fortivex.db
DATABASE_URL=
DATA_RETENTION_DAYS=90
TEMP_AUDIO_TTL_MINUTES=30

# RAG Configuration
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MIN_CONFIDENCE=0.22

# External CRM Integrations (leave blank to use internal SQLite CRM)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
CRM_MOCK_MODE=false

# Business Hours & Timezone
BUSINESS_TIMEZONE=UTC
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

# Security, Multi-Worker Rate Limiting & Reliability
FORTIVEX_API_TOKEN=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_RPM=120
REDIS_URL=
PII_MASKING_ENABLED=false
