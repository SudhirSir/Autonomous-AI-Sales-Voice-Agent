# Optional: Google Gemini API Key for LLM-enhanced dialogue, RAG synthesis, and summarization.
# Leave blank to run in full local intelligent mode (zero external API keys required).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database path
FORTIVEX_DB_PATH=data/fortivex.db

# Optional external CRM webhook URL (e.g., HubSpot/Salesforce/Zapier endpoint)
CRM_WEBHOOK_URL=
