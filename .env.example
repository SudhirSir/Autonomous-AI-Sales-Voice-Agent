# Optional LLM & Embedding Provider (works locally out-of-the-box without keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Pluggable Voice Providers (auto | gemini | deepgram | whisper | elevenlabs | google | local-wav | browser)
STT_PROVIDER=auto
TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GOOGLE_TTS_API_KEY=

# Storage & Knowledge Base
FORTIVEX_DB_PATH=data/fortivex.db

# External CRM Integrations (leave blank to use internal SQLite CRM)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
CRM_MOCK_MODE=false

# Business Hours (UTC)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

# Security & Reliability
FORTIVEX_API_TOKEN=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_RPM=120
PII_MASKING_ENABLED=false
